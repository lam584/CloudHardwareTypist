                health_var.set(health_queue.get_nowait())
        except queue.Empty:
            pass
        try:
            latest_preview = None
            while True:
                latest_preview = clipboard_preview_queue.get_nowait()
        except queue.Empty:
            if latest_preview is not None:
                display_preview = latest_preview
                if len(display_preview) > 4000:
                    display_preview = display_preview[:4000] + "\n…（预览已截断）"
                preview_text.configure(state="normal")
                preview_text.delete("1.0", "end")
                preview_text.insert("1.0", display_preview or "（剪贴板中没有文本）")
                preview_text.configure(state="disabled")
        try:
            latest_update_time = None
            while True:
                latest_update_time = clipboard_update_time_queue.get_nowait()
        except queue.Empty:
            if latest_update_time is not None:
                preview_frame.configure(
                    text=f"剪贴板内容预览｜上次更新时间：{latest_update_time}"
                )
        if shutdown_event.is_set():
            root.destroy()
            return
        root.after(50, refresh_gui)

    root.update_idletasks()
    x_position = max(0, (root.winfo_screenwidth() - root.winfo_width()) // 2)
    y_position = max(0, (root.winfo_screenheight() - root.winfo_height()) // 3)
    root.geometry(f"+{x_position}+{y_position}")
    root.after(50, refresh_gui)
    root.mainloop()
    cancel_event.set()
    shutdown_event.set()


def main() -> None:
    ctypes.set_last_error(0)
    mutex_handle = kernel32.CreateMutexW(None, False, MUTEX_NAME)
    if not mutex_handle:
        show_error(f"Could not create the single-instance guard: {ctypes.WinError(ctypes.get_last_error())}")
        return

    if ctypes.get_last_error() == ERROR_ALREADY_EXISTS:
        existing_window = user32.FindWindowW(None, WINDOW_TITLE)
        if existing_window:
            user32.ShowWindow(existing_window, SW_RESTORE)
            user32.SetForegroundWindow(existing_window)
        kernel32.CloseHandle(mutex_handle)
        return

    try:
        run_gui()
    finally:
        kernel32.CloseHandle(mutex_handle)


if __name__ == "__main__":
    main()
