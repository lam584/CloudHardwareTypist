    )
    preview_frame.pack(fill="x", pady=(8, 0))
    preview_scrollbar = ttk.Scrollbar(preview_frame, orient="vertical")
    preview_scrollbar.pack(side="right", fill="y")
    preview_text = tk.Text(
        preview_frame,
        height=2,
        wrap="word",
        font=("Microsoft YaHei UI", 10),
