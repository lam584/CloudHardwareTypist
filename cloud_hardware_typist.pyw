        padx=6,
        pady=4,
        yscrollcommand=preview_scrollbar.set,
    )
    preview_text.pack(side="left", fill="both", expand=True)
    preview_scrollbar.configure(command=preview_text.yview)
    preview_text.configure(state="disabled")

    settings_frame = ttk.LabelFrame(container, text="自动触发设置", padding=10)
    settings_frame.pack(fill="x", pady=(8, 0))

    ttk.Label(settings_frame, text="剪贴板更新后的有效期：", style="Body.TLabel").grid(row=0, column=0, sticky="w")
    trigger_window_var = tk.DoubleVar(value=auto_trigger_window_seconds)
    trigger_value_frame = ttk.Frame(settings_frame)
    trigger_value_frame.grid(row=0, column=1, sticky="w", padx=(6, 0))
    trigger_spinbox = ttk.Spinbox(
        trigger_value_frame, from_=1.0, to=120.0, increment=1.0,
        textvariable=trigger_window_var, width=8,
    )
    trigger_spinbox.pack(side="left")
    ttk.Label(trigger_value_frame, text="秒", style="Body.TLabel").pack(side="left", padx=(4, 0))

    ttk.Label(settings_frame, text="获得焦点后等待：", style="Body.TLabel").grid(row=1, column=0, sticky="w", pady=(3, 0))
