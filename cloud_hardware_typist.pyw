    focus_value_frame = ttk.Frame(settings_frame)
    focus_value_frame.grid(row=1, column=1, sticky="w", padx=(6, 0), pady=(3, 0))
    focus_spinbox = ttk.Spinbox(
        focus_value_frame, from_=0.0, to=30.0, increment=0.1,
