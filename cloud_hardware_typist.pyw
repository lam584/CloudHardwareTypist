    health_var = tk.StringVar(value="监视线程：正在启动…")
    ttk.Label(
        container,
        textvariable=health_var,
        style="Body.TLabel",
        wraplength=430,
        justify="left",
    ).pack(anchor="w", pady=(5, 0))

    preview_frame = ttk.LabelFrame(
