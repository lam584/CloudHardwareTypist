def show_error(message: str) -> None:
    user32.MessageBoxW(None, message, "Cloud Hardware Typist", 0x10)


def sleep_ms(milliseconds: int) -> bool:
    """Sleep in short intervals so cancellation responds promptly."""
    deadline = time.monotonic() + milliseconds / 1000
    while True:
        if cancel_event.is_set():
            return False
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            return True
        time.sleep(min(remaining, 0.025))


def random_between(low: int, high: int) -> int:
    return random.randint(low, high)


def timing_range(kind: str) -> tuple[int, int]:
    profile = TIMING_PRESETS[timing_preset_name]
    return profile[kind]


def random_timing(kind: str) -> int:
    low, high = timing_range(kind)
    return random_between(low, high)


def key_is_down(virtual_key: int) -> bool:
    return bool(user32.GetAsyncKeyState(virtual_key) & 0x8000)


def read_unicode_clipboard() -> str | None:
    # Clipboard access can briefly be locked by the app that supplied the copied text.
    for _ in range(40):
        if user32.OpenClipboard(None):
            try:
                handle = user32.GetClipboardData(CF_UNICODETEXT)
                if not handle:
                    return None
                pointer = kernel32.GlobalLock(handle)
                if not pointer:
                    return None
                try:
                    return ctypes.wstring_at(pointer)
                finally:
                    kernel32.GlobalUnlock(handle)
            finally:
                user32.CloseClipboard()
        time.sleep(0.025)
    return None


def make_key_map() -> dict[str, tuple[int, bool]]:
    mapping: dict[str, tuple[int, bool]] = {}

    letters = "abcdefghijklmnopqrstuvwxyz"
    letter_scancodes = [
        0x1E, 0x30, 0x2E, 0x20, 0x12, 0x21, 0x22, 0x23, 0x17,
        0x24, 0x25, 0x26, 0x32, 0x31, 0x18, 0x19, 0x10, 0x13,
        0x1F, 0x14, 0x16, 0x2F, 0x11, 0x2D, 0x15, 0x2C,
    ]
    for character, scancode in zip(letters, letter_scancodes, strict=True):
        mapping[character] = (scancode, False)
        mapping[character.upper()] = (scancode, True)

    digits = "1234567890"
    digit_scancodes = [0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0A, 0x0B]
    for character, scancode in zip(digits, digit_scancodes, strict=True):
        mapping[character] = (scancode, False)

    unshifted = ["-", "=", "[", "]", "\\", ";", "'", ",", ".", "/", "`"]
    shifted = ["_", "+", "{", "}", "|", ":", '"', "<", ">", "?", "~"]
    punctuation_scancodes = [0x0C, 0x0D, 0x1A, 0x1B, 0x2B, 0x27, 0x28, 0x33, 0x34, 0x35, 0x29]
    for character, scancode in zip(unshifted, punctuation_scancodes, strict=True):
        mapping[character] = (scancode, False)
    for character, scancode in zip(shifted, punctuation_scancodes, strict=True):
        mapping[character] = (scancode, True)

    mapping["!"] = (0x02, True)
    mapping["@"] = (0x03, True)
    mapping["#"] = (0x04, True)
    mapping["$"] = (0x05, True)
    mapping["%"] = (0x06, True)
    mapping["^"] = (0x07, True)
    mapping["&"] = (0x08, True)
    mapping["*"] = (0x09, True)
    mapping["("] = (0x0A, True)
    mapping[")"] = (0x0B, True)
    return mapping


